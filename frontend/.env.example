# API 基础路径：开发环境留空，走 vite.config.ts 里的 /api/v1 代理，避免直连 8000 跨域
VITE_API_BASE_URL=

# Mock 总开关：分接口开关（VITE_USE_MOCK_<接口名>）未设置时生效
VITE_USE_MOCK=true

# 分接口 Mock 开关，联调时把已就绪的接口改为 false，其余保留 mock
# VITE_USE_MOCK_SEARCH=true
# VITE_USE_MOCK_STOCK_INFO=true
# VITE_USE_MOCK_KLINE=true
# VITE_USE_MOCK_INDICATORS=true
# VITE_USE_MOCK_SCORE=true
# VITE_USE_MOCK_BACKTEST=true
# VITE_USE_MOCK_AI=true
